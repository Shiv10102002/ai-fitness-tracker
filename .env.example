# Copy to .env (git-ignored) or export in your shell before starting the services.
# Config Server serves ${...} placeholders; each service resolves them from its own environment.
GEMINI_API_KEY=your-gemini-api-key
# Optional: Gemini model (default gemini-3.8-flash) and per-call timeout (default 60s)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT=60s
POSTGRES_PASSWORD=postgres
